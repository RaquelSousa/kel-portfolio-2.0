{
  "name": "kel-portfolio-2.0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:analyze": "bun run build && bunx vite-bundle-analyzer dist",
    "build:stats": "vite build --reporter verbose",
    "bundle:analyze": "bun run build && bun scripts/analyze-bundle.js",
    "preview:size": "bun run build && ls -la dist/assets/",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:headless": "cypress run --headless",
    "test:e2e:chrome": "cypress run --browser chrome",
    "test:e2e:firefox": "cypress run --browser firefox",
    "test:e2e:record": "cypress run --record",
    "test:all": "bun run test:run && bun run test:e2e",
    "seo:audit": "bun scripts/seo-audit.js",
    "audit:lighthouse": "lighthouse http://localhost:8080 --quiet --chrome-flags=\"--headless=new\" --output=html --output-path=./lighthouse-report.html",
    "audit:a11y": "axe http://localhost:8080",
    "audit:deadcode": "fallow dead-code",
    "audit:health": "fallow health --score"
  },
